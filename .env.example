# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：Scrapling Collector 授权媒体自动登记（仅在 --profile collector 部署时使用）
# 默认关闭。只有确认拥有媒体访问与存储授权后，才把准确的源站/CDN 主机名加入白名单。
# HLS 的每个子播放列表、分片、音频、字幕和初始化段主机都必须逐一列入；不支持通配符。
SCRAPLING_API_TOKEN=replace-with-a-long-random-secret
DV_INGESTION_TOKEN_FILE=./secrets/dv-ingestion-token
SCRAPLING_EGRESS_FIREWALL_CONFIRMED=0
DV_SOURCE_GATEWAY_ENABLED=0
DV_AUTHORIZED_SOURCE_HOSTS=
DV_SOURCE_GATEWAY_MAX_BYTES=536870912
DV_SOURCE_GATEWAY_TIMEOUT_SECONDS=15
DV_SOURCE_GATEWAY_TOTAL_TIMEOUT_SECONDS=3600

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:<版本>

# 可选：Friday 英文 JARVIS Piper TTS（仅英文；未配置时继续使用 Microsoft Edge TTS）
# JARVIS_TTS_URL=https://voice.example.com
# JARVIS_TTS_TOKEN=replace-with-a-long-random-secret
