# 必填：访问密码（不设置时站点会提示管理员配置后再可用）
PASSWORD=change-me

# 可选：会话/代理签名密钥；不设置时从 PASSWORD 派生
# PROXY_SECRET=

# 可选：Cookie Secure 策略覆盖（true=强制开启 / false=强制关闭；不设置时按请求协议自动推导，HTTP 部署无需配置）
# COOKIE_SECURE=

# 可选：代理请求上游的超时与重试
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视榜单推荐源（60s API）实例地址，默认官方公共实例 https://60s.viki.moe。
# 官方实例有限流（本项目每小时仅请求 6 次榜单，通常够用）；高频使用可自部署：docker run -d -p 4399:4399 vikiboss/60s:latest
# 60S_API_BASE=https://60s.viki.moe

# 可选：调试
DEBUG=false

# 可选：固定使用某个发布镜像版本（默认不设置 = ghcr.io/librespark/libretv:latest，
# 首次部署先 docker compose pull 拉取；本地开发可用 docker compose up -d --build 构建）
# LIBRETV_IMAGE=ghcr.io/librespark/libretv:<版本>

# 可选：Friday 英文 JARVIS Piper TTS（仅英文；未配置时继续使用 Microsoft Edge TTS）
# JARVIS_TTS_URL=https://voice.example.com
# JARVIS_TTS_TOKEN=replace-with-a-long-random-secret

# 可选：独立智能爬虫服务连接（启用 /crawler 控制中心时配置）
# SCRAPLING_ENGINE_URL=https://scrapling-engine.example.com
# SCRAPLING_ENGINE_API_KEY=replace-with-a-random-secret-at-least-32-characters

# 可选：启用独立智能爬虫（docker compose --profile crawler up -d）
# 生产环境必须设置为不同的强随机值；SCRAPLING_API_KEY 至少 32 位，仅经内部网络传递。
# SCRAPLING_API_KEY=replace-with-at-least-32-random-characters
# SCRAPLING_DB_PASSWORD=replace-with-a-strong-database-password
# SCRAPLING_ENGINE_URL=http://scrapling-engine:8787

# Optional AI Supervisor (OpenAI-compatible chat completions endpoint).
# Required only to enable model-planned discovery and AI extraction-rule generation.
# SUPERVISOR_API_BASE=https://api.openai.com/v1
# SUPERVISOR_API_KEY=replace-with-provider-api-key
# SUPERVISOR_MODEL=gpt-4.1-mini
# SUPERVISOR_TIMEOUT_SECONDS=45
